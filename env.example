# URL de ton instance Readeck (sans slash final)
READECK_URL=https://readeck.abbadie.ovh

# Token API Readeck
# Récupérable dans : Readeck → Settings → Applications → Create token
READECK_TOKEN=TON_TOKEN

# Clé API OpenRouter (optionnelle, seulement pour la traduction)
# Récupérable sur : https://openrouter.ai/keys
OPENROUTER_API_KEY=TA_CLE_OPENROUTER

# Modèle OpenRouter utilisé pour la traduction (privilégier un modèle ":free")
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
